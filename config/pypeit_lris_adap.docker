# The one container for every job in nautilus_jobs, the redis server in
# workqueue_deployment.yml excepted. Those jobs all run as uid 1001 and expect a
# venv at /home/pypeitusr/pypeit_env, a PypeIt clone at /home/pypeitusr/PypeIt,
# rclone, git and aws on the PATH, and credentials mounted under /home/pypeitusr.
# Everything the adap scripts import is installed here, so the jobs do no pip
# installs of their own beyond reinstalling PypeIt after they update its checkout.
#
# That reinstall must use --no-build-isolation, as the install below does, or pip
# builds against an unpatched vcs_versioning and hits the bug patched here.
#
# Push as:
#   docker push gitlab-registry.nrp-nautilus.io/bradh/pypeitcontainers/pypeit_lris_adap:adap_2023
#
# The awscli download below is x86_64 only, so build for the nautilus nodes:
#   docker build --platform linux/amd64 \
#     -t gitlab-registry.nrp-nautilus.io/bradh/pypeitcontainers/pypeit_lris_adap:adap_2023 \
#     -f config/pypeit_lris_adap.docker .

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV QT_QPA_PLATFORM=offscreen
ENV PATH="/home/pypeitusr/pypeit_env/bin:${PATH}"
# gspread finds its service account under $HOME, the scripts default --rclone_conf to
# $HOME, and rclone's s3 remote uses env_auth, which finds ~/.aws/credentials the same
# way. Set HOME
# explicitly rather than relying on it being looked up from runAsUser: 1001.
ENV HOME=/home/pypeitusr

RUN apt-get update && apt-get install -y \
    git \
    curl \
    wget \
    unzip \
    build-essential \
    rclone \
    python3 \
    python3-venv \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

RUN curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip && \
    unzip /tmp/awscliv2.zip -d /tmp && \
    /tmp/aws/install && \
    rm -rf /tmp/awscliv2.zip /tmp/aws

RUN useradd -m -u 1001 -s /bin/bash pypeitusr

USER pypeitusr
WORKDIR /home/pypeitusr

# Create virtualenv and install PypeIt from lris_adap branch
RUN python3 -m venv pypeit_env && \
    pypeit_env/bin/pip install --upgrade pip setuptools wheel

RUN  pypeit_env/bin/pip install astropy

RUN git clone https://github.com/pypeit/PypeIt.git && \
    cd PypeIt && \
    git checkout lris_adap && \
    /home/pypeitusr/pypeit_env/bin/pip install setuptools "setuptools_scm[toml]" vcs_versioning wheel && \
    /home/pypeitusr/pypeit_env/bin/python3 -c \
"import vcs_versioning._get_version_impl as m, pathlib; p = pathlib.Path(m.__file__); s = p.read_text(); p.write_text(s.replace('target.relative_to(root)', '(root / target if not target.is_absolute() else target).relative_to(root)'))" && \
    /home/pypeitusr/pypeit_env/bin/pip install --no-build-isolation -e ".[dev]"

# Install adap project from adap_2023 branch
RUN git clone https://github.com/pypeit/adap.git && \
    cd adap && \
    git checkout adap_2023

# Install additional runtime dependencies. psutil is listed explicitly even though
# PypeIt's [dev] extra happens to pull it in too: reduce_from_queue.py needs it to sample
# a reduction's memory use, and that should not rest on a PypeIt development extra.
RUN pypeit_env/bin/pip install \
    redis \
    boto3 \
    google-api-python-client \
    gspread \
    pykoa \
    psutil

WORKDIR /home/pypeitusr/adap
