FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV QT_QPA_PLATFORM=offscreen
ENV PATH="/home/pypeitusr/pypeit_env/bin:${PATH}"

RUN apt-get update && apt-get install -y \
    git \
    curl \
    wget \
    unzip \
    build-essential \
    rclone \
    python3 \
    python3-venv \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

RUN curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip && \
    unzip /tmp/awscliv2.zip -d /tmp && \
    /tmp/aws/install && \
    rm -rf /tmp/awscliv2.zip /tmp/aws

RUN useradd -m -u 1001 -s /bin/bash pypeitusr

USER pypeitusr
WORKDIR /home/pypeitusr

# Create virtualenv and install PypeIt from lris_adap branch
RUN python3 -m venv pypeit_env && \
    pypeit_env/bin/pip install --upgrade pip setuptools wheel

RUN  pypeit_env/bin/pip install astropy

RUN git clone https://github.com/pypeit/PypeIt.git && \
    cd PypeIt && \
    git checkout lris_adap && \
    /home/pypeitusr/pypeit_env/bin/pip install setuptools "setuptools_scm[toml]" vcs_versioning wheel && \
    /home/pypeitusr/pypeit_env/bin/python3 -c \
"import vcs_versioning._get_version_impl as m, pathlib; p = pathlib.Path(m.__file__); s = p.read_text(); p.write_text(s.replace('target.relative_to(root)', '(root / target if not target.is_absolute() else target).relative_to(root)'))" && \
    /home/pypeitusr/pypeit_env/bin/pip install --no-build-isolation -e ".[dev]"

# Install adap project from adap_2023 branch
RUN git clone https://github.com/pypeit/adap.git && \
    cd adap && \
    git checkout adap_2023

# Install additional runtime dependencies
RUN pypeit_env/bin/pip install \
    redis \
    boto3 \
    google-api-python-client \
    gspread

WORKDIR /home/pypeitusr/adap
